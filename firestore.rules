rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /pairCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if isMember(coupleId);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isMember(coupleId);

      match /photos/{photoId} {
        allow read, write: if isMember(coupleId);
      }
      match /quizzes/{quizId} {
        allow read, write: if isMember(coupleId);
      }
      match /location/{userId} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == userId;
      }
      match /mood/{userId} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isMember(coupleId) && resource.data.fromUid == request.auth.uid;
      }
    }

    match /boards/{boardId} {
      allow read, write: if isSignedIn() &&
        isMember(boardId.split('_board')[0]);
    }
  }
}
